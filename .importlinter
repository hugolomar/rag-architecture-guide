[importlinter]
root_package = src
include_external_packages = True

[importlinter:contract:domain-isolation]
name = Domain layer must not import infrastructure or ingestion
type = forbidden
source_modules =
    src.domain
forbidden_modules =
    src.adapters
    src.ingestion
    qdrant_client
    fastembed
    opentelemetry

[importlinter:contract:pipeline-isolation]
name = Pipeline orchestration must not import concrete storage or embedding adapters
type = forbidden
source_modules =
    src.ingestion.pipeline
forbidden_modules =
    src.adapters.storage
    src.adapters.embeddings
    qdrant_client
    fastembed

# Stage 1: Build & Dependency Resolution
FROM python:3.14-slim AS builder

WORKDIR /build

# Install uv package manager
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Copy dependency specifications
COPY pyproject.toml uv.lock ./

# Install locked dependencies into .venv without development packages
RUN uv sync --frozen --no-dev

# Stage 2: Minimal Production Runtime
FROM python:3.14-slim AS runtime

WORKDIR /app

# Exclude build tools (uv, compilers) from runtime image
# Copy virtual environment directly from builder
COPY --from=builder /build/.venv /app/.venv

# Pre-cache FastEmbed ONNX models in runtime image to prevent startup downloads
ENV PATH="/app/.venv/bin:$PATH"
RUN python -c "from fastembed import TextEmbedding, SparseTextEmbedding; TextEmbedding('BAAI/bge-large-en-v1.5'); TextEmbedding('BAAI/bge-small-en-v1.5'); SparseTextEmbedding('Qdrant/bm25')"

# Create non-root user and setup home directory with cached model weights
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -s /bin/false appuser && \
    cp -r /root/.cache /home/appuser/.cache && \
    chown -R appuser:appgroup /app /home/appuser

# Copy application source code
COPY src /app/src

# Switch to non-root execution
USER appuser
ENV HOME="/home/appuser"

# Default environment variables
ENV QDRANT_HOST=qdrant \
    QDRANT_PORT=6333 \
    QDRANT_COLLECTION_NAME=governed_docs \
    DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5 \
    KEYCLOAK_URL=http://keycloak:8080 \
    KEYCLOAK_REALM=master \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318 \
    OTEL_SERVICE_NAME=rag-api \
    PORT=8000 \
    LOG_LEVEL=INFO \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz').read()"]

ENTRYPOINT ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
